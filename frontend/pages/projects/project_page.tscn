[gd_scene load_steps=5 format=3 uid="uid://e0fu8lh8ewl4"]

[ext_resource type="Script" uid="uid://d4gv1o4oyl6ag" path="res://pages/projects/project_page.gd" id="1_dtdpq"]
[ext_resource type="Texture2D" uid="uid://dujpwevouq8ab" path="res://res/icons/magnifying-glass-bold.png" id="2_mg64l"]
[ext_resource type="Texture2D" uid="uid://brwgvk21r4atj" path="res://res/icons/plus-bold.png" id="3_2j6ad"]
[ext_resource type="PackedScene" uid="uid://dularfrh3frse" path="res://components/loading/loading_spinner.tscn" id="4_jtadv"]

[node name="ProjectPage" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 32
script = ExtResource("1_dtdpq")

[node name="FetchHTTPRequest" type="HTTPRequest" parent="."]
unique_name_in_owner = true

[node name="Label" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"HeaderLarge"
text = "PROJECTS"

[node name="HBoxContainer" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="LineEdit" type="LineEdit" parent="HBoxContainer"]
modulate = Color(0, 0, 0, 0.8)
custom_minimum_size = Vector2(256, 0)
layout_mode = 2
theme_type_variation = &"SearchBar"
placeholder_text = "SEARCH_PROJECTS"
right_icon = ExtResource("2_mg64l")
caret_blink = true

[node name="Control" type="Control" parent="HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="NewProjectButton" type="Button" parent="HBoxContainer"]
layout_mode = 2
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "NEW_PROJECT"
icon = ExtResource("3_2j6ad")

[node name="LoadingSpinner" parent="." instance=ExtResource("4_jtadv")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 6

[node name="ProjectContainer" type="GridContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
columns = 3

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"SecondaryText"
text = "NO_PROJECT_MSG"
horizontal_alignment = 1
vertical_alignment = 1

[connection signal="request_completed" from="FetchHTTPRequest" to="." method="_on_fetch_http_request_request_completed"]
[connection signal="pressed" from="HBoxContainer/NewProjectButton" to="." method="_on_new_project_button_pressed"]
