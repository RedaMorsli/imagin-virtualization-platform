[node name="ProjectPage" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 64
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 64
script = ExtResource("1_dtdpq")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 0
theme = ExtResource("1_3v2q0")
theme_override_constants/separation = 32

[node name="Label" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLarge"
text = "PROJECTS"

[node name="HBoxContainer" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="LineEdit" type="LineEdit" parent="VBox/HBoxContainer"]
modulate = Color(0, 0, 0, 0.8)
custom_minimum_size = Vector2(256, 0)
layout_mode = 2
theme_type_variation = &"SearchBar"
placeholder_text = "SEARCH_PROJECTS"
